# Dominio público del servidor, sin https://. Debe resolver a esta máquina
# y tener abiertos los puertos 80 y 443 para que Caddy obtenga el certificado.
MDM_DOMAIN=mdm.ejemplo.es

# Contraseña de PostgreSQL. Usa solo letras y números (va dentro de una URL).
# Para generar una:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Clave que cifra los datos sensibles (claves de BitLocker, credenciales de
# Google, contraseña SMTP). Genérala una vez y guárdala con las copias de
# seguridad: si se pierde, esos datos no se pueden recuperar.
#   openssl rand -base64 32
MDM_SECRET_KEY=

# Versión con la que se etiqueta la imagen.
MDM_VERSION=2.0.0
